{
  "name": "obsidian-docx-claude",
  "version": "0.0.1",
  "description": "Read-only docx preview in Obsidian with Claude-mediated edits via claude-cli-chat.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["obsidian", "docx", "claude"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.5.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "docx-preview": "^0.3.0",
    "fast-xml-parser": "^4.3.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.6.0"
  }
}
