{
  "name": "obsidian-msoffice-viewer",
  "version": "0.3.0",
  "description": "Read-only viewer for .docx, .pptx, .xlsx, and .xls inside Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "docx",
    "pptx",
    "xlsx",
    "office",
    "preview"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.5.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "docx": "^9.6.1",
    "docx-preview": "^0.3.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "numfmt": "^3.2.6",
    "pdfjs-dist": "^5.7.284",
    "pptxgenjs": "^4.0.1",
    "pptxviewjs": "^1.1.9"
  }
}
